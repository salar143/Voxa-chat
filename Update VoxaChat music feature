<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Voxa Chat</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{color-scheme:dark;--bg:#100d1c;--panel:#1d1730;--panel2:#29203f;--line:#413357;--purple:#8b5cf6;--gold:#f3c86a;--text:#faf7ff;--muted:#c1b7d3}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#281845 0,var(--bg) 55%);color:var(--text);font:16px system-ui,-apple-system,Segoe UI,sans-serif}header{position:sticky;top:0;z-index:3;background:#100d1cf2;border-bottom:1px solid var(--line);padding:14px max(16px,calc((100% - 900px)/2));display:flex;justify-content:space-between;align-items:center}.brand{font-size:25px;font-weight:850}.brand b{color:var(--gold)}main{max-width:900px;margin:auto;padding:20px 14px 90px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:17px;margin:12px 0}.hero{background:linear-gradient(125deg,#39235a,#1c1730);padding:24px}.hero h1{margin:0 0 8px;font-size:clamp(25px,6vw,38px)}.muted,.hint{color:var(--muted);font-size:14px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.row{display:flex;gap:8px;align-items:center}.row input{min-width:0;flex:1}button,input,textarea,select{font:inherit;border-radius:11px;padding:11px;border:1px solid var(--line)}button{background:var(--purple);color:white;border:0;font-weight:750;cursor:pointer}button.secondary{background:var(--panel2);border:1px solid var(--line)}button:disabled{opacity:.5}input,textarea,select{background:#100d1c;color:var(--text);width:100%;margin:5px 0 10px}label{font-size:13px;color:var(--muted)}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin:16px 0}.tabs button.active{background:var(--gold);color:#24172e}.hidden{display:none!important}.pill{font-size:12px;color:var(--gold);background:#3b2a50;border-radius:99px;padding:4px 9px;display:inline-block}.room h3{margin:9px 0 5px}.room p{color:var(--muted);font-size:14px}.room .row{margin-top:14px}.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:8px}.messages{height:300px;overflow:auto;display:flex;flex-direction:column;gap:8px;margin:12px 0}.msg{padding:10px 12px;background:var(--panel2);border-radius:12px;overflow-wrap:anywhere}.msg small{display:block;color:var(--gold);margin-bottom:3px}.status{background:#151124;border:1px solid var(--line);border-radius:12px;padding:10px;color:var(--muted);font-size:13px;margin:10px 0}.bottom{position:fixed;bottom:0;left:0;right:0;z-index:4;background:#100d1cf5;border-top:1px solid var(--line);display:flex;justify-content:center;gap:8px;padding:8px}.bottom button{width:22%;max-width:170px;padding:10px 3px}.seat{padding:12px;border:1px solid var(--line);border-radius:12px;text-align:center;background:var(--panel2)}.error{color:#ffb4b4}.success{color:#b8f5cd}
</style></head>
<body>
<header><div class="brand">Voxa<b>Chat</b> 💜</div><button id="authToggle" class="secondary">Login</button></header>
<main>
<section id="auth" class="panel">
<div class="sectionhead"><h2 id="authTitle">Welcome back</h2><span class="pill">Account</span></div>
<p class="muted">Use your email to sign in or create an account.</p>
<label>Email</label><input id="email" type="email" autocomplete="email" placeholder="you@example.com">
<label>Password</label><input id="password" type="password" autocomplete="current-password" placeholder="At least 6 characters">
<div class="row"><button id="authSubmit">Log in</button><button id="modeToggle" class="secondary">Create account</button></div>
<div id="authStatus" class="status">Connect to sign in.</div>
</section>
<section id="app" class="hidden">
<div class="hero panel"><h1>Find your people.</h1><p class="muted">Discover rooms and chat with your community.</p><button id="heroRooms">Explore rooms</button></div>
<div class="tabs"><button class="active" data-page="home">Home</button><button data-page="rooms">Rooms</button><button data-page="messages">Messages</button><button data-page="profile">Profile</button></div>
<section id="home"><div class="sectionhead"><h2>Discover rooms</h2><button id="createBtn">＋ Create</button></div><div id="homeRooms" class="grid"></div></section>
<section id="rooms" class="hidden"><div class="sectionhead"><h2>All rooms</h2><button id="createBtn2">＋ Create</button></div><div id="allRooms" class="grid"></div></section>
<section id="messages" class="hidden"><div class="panel"><h2>Room messages</h2><p id="activeRoomLabel" class="muted">Choose a room to load its messages.</p><div id="messageList" class="messages"></div><div class="row"><input id="messageText" placeholder="Write a message…" maxlength="2000"><button id="sendMessage">Send</button></div><div class="hint">Messages are stored in Supabase and updated live for subscribed members.</div></div></section>
<section id="profile" class="hidden"><div class="panel"><h2>Your profile</h2><label>Display name</label><input id="displayName" maxlength="40" placeholder="Display name"><button id="saveProfile">Save profile</button><div id="profileStatus" class="status"></div><p id="userEmail" class="muted"></p><button id="logout" class="secondary">Log out</button></div></section>
<section id="roomView" class="hidden"><button id="backRooms" class="secondary">← Rooms</button><div class="panel"><span class="pill">ROOM</span><h2 id="roomTitle"></h2><p id="roomTopic" class="muted"></p><div id="roomStatus" class="status"></div><div id="seats" class="grid"></div><div class="row"><button id="roomChat">Open chat</button><button id="joinVoice" class="secondary">Join voice (experimental)</button><button id="leaveVoice" class="secondary">Leave voice</button></div><div id="voiceStatus" class="status">Voice is not connected.</div><audio id="remoteAudio" autoplay playsinline></audio></div></section>
</section>
<div id="globalStatus" class="status">Initializing…</div>
</main>
<nav class="bottom hidden" id="bottomNav"><button class="secondary" data-page="home">🏠 Home</button><button class="secondary" data-page="rooms">🎙 Rooms</button><button class="secondary" data-page="messages">💬 Chat</button><button class="secondary" data-page="profile">👤 Me</button></nav>
<script>
const SUPABASE_URL='https://opckvbeyupvkeojnvnej.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_hIRf-JGkAhWtldNYc3SBEw_5clrRwV7';
const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);
let user=null,profile=null,rooms=[],activeRoom=null,msgChannel=null,voiceChannel=null,peers=new Map(),localStream=null,authMode='login',voicePeers=new Set();
const $=id=>document.getElementById(id);
function status(id,msg,kind=''){const el=$(id);if(el){el.textContent=msg;el.className='status '+kind}}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showPage(name){['home','rooms','messages','profile','roomView'].forEach(n=>$(n).classList.toggle('hidden',n!==name));document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===name));if(name==='rooms'||name==='home')loadRooms()}
function renderRooms(){let cards=rooms.map(r=>`<article class="panel room"><span class="pill">${esc(r.capacity)} seats</span><h3>${esc(r.name)}</h3><p>${esc(r.topic||'Community room')}</p><p class="muted">Created ${new Date(r.created_at).toLocaleDateString()}</p><button data-join="${r.id}">Join room</button></article>`).join('')||'<p class="muted">No rooms yet. Create the first one.</p>';$('homeRooms').innerHTML=cards;$('allRooms').innerHTML=cards}
async function loadRooms(){if(!user)return;const {data,error}=await sb.from('rooms').select('*').order('created_at',{ascending:false});if(error){status('globalStatus','Rooms failed to load: '+error.message,'error');return}rooms=data||[];renderRooms()}
async function loadProfile(){let {data}=await sb.from('profiles').select('*').eq('id',user.id).maybeSingle();profile=data;if(profile){$('displayName').value=profile.display_name||''}}
async function startApp(){if(!user){$('auth').classList.remove('hidden');$('app').classList.add('hidden');$('bottomNav').classList.add('hidden');$('authToggle').textContent='Login';status('globalStatus','Please log in to use Voxa Chat.');return}
$('auth').classList.add('hidden');$('app').classList.remove('hidden');$('bottomNav').classList.remove('hidden');$('authToggle').textContent='Account';$('userEmail').textContent=user.email||'';status('globalStatus','Signed in as '+(user.email||user.id));await loadProfile();await loadRooms()}
$('authToggle').onclick=()=>{if(user)showPage('profile');else $('auth').classList.toggle('hidden')};
$('modeToggle').onclick=()=>{authMode=authMode==='login'?'signup':'login';$('authTitle').textContent=authMode==='login'?'Welcome back':'Create your account';$('authSubmit').textContent=authMode==='login'?'Log in':'Sign up';$('modeToggle').textContent=authMode==='login'?'Create account':'Back to login';$('password').autocomplete=authMode==='login'?'current-password':'new-password';status('authStatus',authMode==='signup'?'A confirmation email may be required.':'Enter your login details.')};
$('authSubmit').onclick=async()=>{let email=$('email').value.trim(),password=$('password').value;if(!email||password.length<6){status('authStatus','Enter a valid email and password (minimum 6 characters).','error');return}$('authSubmit').disabled=true;let result=authMode==='login'?await sb.auth.signInWithPassword({email,password}):await sb.auth.signUp({email,password});$('authSubmit').disabled=false;if(result.error){status('authStatus',result.error.message,'error');return}if(authMode==='signup'&&!result.data.session){status('authStatus','Account created. Check your email to confirm, then log in.','success');return}user=result.data.user;await startApp()};
async function createRoom(){let name=prompt('Room name');if(!name?.trim())return;let topic=prompt('Room topic','Meet and chat')||'';let cap=Number(prompt('Capacity (2–50)','12'));cap=Math.max(2,Math.min(50,Number.isFinite(cap)?cap:12));let {data,error}=await sb.from('rooms').insert({name:name.trim(),topic:topic.trim(),capacity:cap,created_by:user.id}).select().single();if(error){alert('Could not create room: '+error.message);return}await loadRooms();openRoom(data)}
async function openRoom(room){activeRoom=room;$('roomTitle').textContent=room.name;$('roomTopic').textContent=room.topic||'';showPage('roomView');status('roomStatus','Joining room…');const {error}=await sb.from('room_members').upsert({room_id:room.id,user_id:user.id},{onConflict:'room_id,user_id'});if(error){status('roomStatus','Could not join room: '+error.message,'error');return}await loadSeats();await subscribeMessages(room);status('roomStatus','You joined this room.');}
async function loadSeats(){if(!activeRoom)return;const {data,error}=await sb.from('room_members').select('user_id,joined_at,profiles(display_name)').eq('room_id',activeRoom.id).order('joined_at');if(error){$('seats').innerHTML='<p class="muted">Member list unavailable: '+esc(error.message)+'</p>';return}$('seats').innerHTML=(data||[]).map(m=>`<div class="seat">👤<br><b>${esc(m.profiles?.display_name||'Member')}</b><p class="muted">${m.user_id===user.id?'You':'Member'}</p></div>`).join('')||'<p class="muted">No members listed yet.</p>'}
async function subscribeMessages(room){if(msgChannel){await sb.removeChannel(msgChannel);msgChannel=null}const {data,error}=await sb.from('voxa_messages').select('id,user_id,message,created_at').eq('room_id',room.id).order('created_at').limit(100);if(error){status('globalStatus','Messages unavailable: '+error.message,'error');return}renderMessages(data||[]);$('activeRoomLabel').textContent='Room: '+room.name;msgChannel=sb.channel('messages-'+room.id).on('postgres_changes',{event:'INSERT',schema:'public',table:'voxa_messages',filter:'room_id=eq.'+room.id},payload=>{const el=$('messageList');if(!el.querySelector('[data-msg="'+payload.new.id+'"]'))appendMessage(payload.new)}).subscribe()}
function appendMessage(m){const el=$('messageList'),div=document.createElement('div');div.className='msg';div.dataset.msg=m.id;div.innerHTML='<small>'+esc(m.user_id===user.id?(profile?.display_name||'You'):'Member')+' · '+esc(new Date(m.created_at).toLocaleTimeString())+'</small>'+esc(m.message);el.appendChild(div);el.scrollTop=el.scrollHeight}
function renderMessages(list){$('messageList').innerHTML='';list.forEach(appendMessage)}
$('sendMessage').onclick=async()=>{if(!activeRoom)return alert('Join a room first.');let text=$('messageText').value.trim();if(!text)return;const {error}=await sb.from('voxa_messages').insert({user_id:user.id,room_id:activeRoom.id,message:text});if(error){status('globalStatus','Message failed: '+error.message,'error');return}$('messageText').value=''};
$('messageText').addEventListener('keydown',e=>{if(e.key==='Enter')$('sendMessage').click()});
$('saveProfile').onclick=async()=>{let name=$('displayName').value.trim().slice(0,40);if(!name)return status('profileStatus','Enter a display name.','error');let {error}=await sb.from('profiles').upsert({id:user.id,display_name:name,updated_at:new Date().toISOString()});if(error){status('profileStatus','Profile save failed: '+error.message,'error');return}profile={...(profile||{}),id:user.id,display_name:name};status('profileStatus','Profile saved.','success')};
$('logout').onclick=async()=>{await leaveVoice();await sb.auth.signOut();user=null;profile=null;startApp()};
$('heroRooms').onclick=()=>showPage('rooms');$('createBtn').onclick=createRoom;$('createBtn2').onclick=createRoom;$('backRooms').onclick=()=>showPage('rooms');$('roomChat').onclick=()=>showPage('messages');
document.addEventListener('click',e=>{let b=e.target.closest('[data-page]');if(b)showPage(b.dataset.page);let j=e.target.closest('[data-join]');if(j){let r=rooms.find(x=>x.id===j.dataset.join);if(r)openRoom(r)}});
// Experimental mesh voice: requires Realtime Broadcast enabled and both users in same room.
async function joinVoice(){if(!activeRoom)return;try{localStream=await navigator.mediaDevices.getUserMedia({audio:true});voiceChannel=sb.channel('voice-'+activeRoom.id,{config:{broadcast:{self:false}}});voiceChannel.on('broadcast',{event:'signal'},async({payload})=>{if(payload.to&&payload.to!==user.id)return;if(payload.from===user.id)return;let pc=peers.get(payload.from);if(!pc){pc=makePeer(payload.from);peers.set(payload.from,pc)}if(payload.description){await pc.setRemoteDescription(payload.description);if(payload.description.type==='offer'){await pc.setLocalDescription(await pc.createAnswer());sendSignal({to:payload.from,description:pc.localDescription})}}else if(payload.candidate){try{await pc.addIceCandidate(payload.candidate)}catch{}}});await voiceChannel.subscribe(async s=>{if(s!=='SUBSCRIBED')return;status('voiceStatus','Microphone enabled. Waiting for other room members; voice is experimental.');await voiceChannel.send({type:'broadcast',event:'signal',payload:{from:user.id,hello:true}})});status('voiceStatus','Microphone enabled. Browser permissions granted; voice connectivity is experimental.')}catch(e){status('voiceStatus','Voice could not start: '+e.message,'error')}}
function makePeer(id){let pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'}]});localStream?.getTracks().forEach(t=>pc.addTrack(t,localStream));pc.onicecandidate=e=>{if(e.candidate)sendSignal({to:id,candidate:e.candidate})};pc.ontrack=e=>{$('remoteAudio').srcObject=e.streams[0]};pc.onnegotiationneeded=async()=>{try{await pc.setLocalDescription(await pc.createOffer());sendSignal({to:id,description:pc.localDescription})}catch{}};return pc}
function sendSignal(payload){voiceChannel?.send({type:'broadcast',event:'signal',payload:{...payload,from:user.id}})}
async function leaveVoice(){if(voiceChannel){await sb.removeChannel(voiceChannel);voiceChannel=null}for(const p of peers.values())p.close();peers.clear();if(localStream)localStream.getTracks().forEach(t=>t.stop());localStream=null;$('remoteAudio').srcObject=null;status('voiceStatus','Voice disconnected.')}
$('joinVoice').onclick=joinVoice;$('leaveVoice').onclick=leaveVoice;
(async()=>{const {data:{session}}=await sb.auth.getSession();user=session?.user||null;sb.auth.onAuthStateChange((_event,session)=>{user=session?.user||null;setTimeout(()=>startApp(),0)});await startApp()})();
</script></body></html>
